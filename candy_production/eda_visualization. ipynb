   "source": [
    "# Seasonal Decomposition\n",
    "\n",
    "import seaborn as sns\n",
    "from statsmodels.tsa.seasonal import seasonal_decompose\n",
    "from statsmodels.graphics.tsaplots import plot_acf, plot_pacf,acf,pacf\n",
