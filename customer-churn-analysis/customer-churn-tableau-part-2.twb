          </datasources>
          <datasource-dependencies datasource='federated.0ssfjky1j4onp119ekd0e1abz0qf'>
            <column aggregation='None' caption='Avg Monthly GB Download (bin)' datatype='integer' name='[Avg Monthly GB Download (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[Avg Monthly GB Download]' peg='0' size='10' />
            </column>
            <column datatype='integer' name='[Avg Monthly GB Download]' role='measure' type='quantitative' />
            <column caption='Service bundle group' datatype='string' name='[Calculation_203224944594878468]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Phone Service] = &apos;Yes&apos; AND [Internet Service] = &apos;Yes&apos; THEN &apos;Both&apos;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Phone Service] = &apos;Yes&apos; AND [Internet Service] = &apos;No&apos; THEN &apos;Phone Only&apos;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Phone Service] = &apos;No&apos; AND [Internet Service] = &apos;Yes&apos; THEN &apos;Internet Only&apos;&#13;&#10;&#13;&#10;&#13;&#10;ELSE &apos;None&apos;&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[Churn Flag]' role='measure' type='quantitative'>
              <aliases>
                <alias key='0' value='STAYED' />
                <alias key='1' value='CHURNED' />
              </aliases>
            </column>
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Internet Service]' role='dimension' type='nominal' />
            <column datatype='string' name='[Phone Service]' role='dimension' type='nominal' />
            <column-instance column='[Customer ID]' derivation='CountD' name='[ctd:Customer ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Avg Monthly GB Download (bin)]' derivation='None' name='[none:Avg Monthly GB Download (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_203224944594878468]' derivation='None' name='[none:Calculation_203224944594878468:nk]' pivot='key' type='nominal' />
            <column-instance column='[Churn Flag]' derivation='Sum' name='[sum:Churn Flag:qk]' pivot='key' type='quantitative' />
