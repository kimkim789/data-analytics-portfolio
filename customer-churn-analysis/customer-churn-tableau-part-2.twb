      </column>
      <column caption='Customers at Start of Month' datatype='integer' name='[Calculation_203224944578002945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM(1), 0, LAST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monthly Churn Rate' datatype='real' name='[Calculation_203224944578187266]' role='measure' type='quantitative'>
